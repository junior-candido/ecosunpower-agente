# Servidor
PORT=3000
NODE_ENV=production

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE=ecosunpower
WEBHOOK_TOKEN=um-token-secreto-para-validar-webhooks

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-sua-chave

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-key

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Engenheiro (numero que recebe dossies)
ENGINEER_PHONE=5561999999999
ENGINEER_NAME=Seu Nome

# Tavus (clone de video do Junior pra anuncios Meta)
TAVUS_API_KEY=sua-tavus-api-key
TAVUS_REPLICA_ID=r6e1a145xxxxxxxx
TAVUS_API_URL=https://tavusapi.com

# Meta Conversions API — dataset/antigo pixel. SEM default no codigo (identidade
# da empresa). Sem a env o CAPI fica off com aviso no boot.
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# META_CAPI_DATASET_ID=1053629086258723
META_CAPI_DATASET_ID=

# Repo GitHub do site (blog auto-publisher + /novo-case). SEM default no codigo
# (identidade da empresa). Sem a env a publicacao no site fica off com aviso.
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# GITHUB_SITE_REPO=junior-candido/ecosunpower-site
GITHUB_SITE_REPO=

# Para onde vai a RESPOSTA do cliente aos e-mails da jornada.
# Obrigatorio na pratica: o EMAIL_FROM fica num subdominio de ENVIO da Resend
# (ex. news.empresa.com.br), que assina e entrega mas NAO tem MX — nao recebe.
# Como os 6 modelos terminam com "e so responder este e-mail", sem esta variavel
# toda resposta de cliente volta como bounce e ninguem fica sabendo.
# Se faltar, o app grita no boot: "[email-seq] ATENCAO: EMAIL_REPLY_TO nao configurado".
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# EMAIL_REPLY_TO=junior@ecosunpower.eng.br
EMAIL_REPLY_TO=

# Caixa que a Resend RECEBE (Emails -> Receiving). Quando preenchida, e ela que
# vai no Reply-To dos e-mails da jornada, e a resposta do cliente ENTRA no
# sistema: casa com o lead, grava na ficha, tira ele da regua de e-mail, avisa
# o Junior no WhatsApp e ainda manda copia pro EMAIL_REPLY_TO.
# Sem ela, a resposta vai direto pro EMAIL_REPLY_TO (funciona, so nao e automatico).
# Precisa do evento `email.received` marcado no webhook da Resend.
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# EMAIL_INBOUND_ADDRESS=respostas@woupri.resend.app
EMAIL_INBOUND_ADDRESS=

# Senha que o medidor Shelly usa pra provar que a leitura e dele.
# O endereco /webhooks/shelly e PUBLICO: sem esse token qualquer um grava
# medicao na base de um cliente — e medicao envenenada vira laudo errado,
# assinado por um responsavel tecnico. Sem o token configurado aqui, o
# servidor RECUSA TODA leitura e grita no log (em vez de ficar aberto calado).
# Gere um valor longo e aleatorio e ponha o MESMO no script do aparelho.
SHELLY_INGEST_TOKEN=

# Leitor por IA do programa Gerador de Relatórios Solar (SunBright) — rotas públicas
# /api/leitor/conta e /api/leitor/monitoramento. Usa a ANTHROPIC_API_KEY acima. Tudo opcional
# (sem nada = padrão seguro). A imagem é lida e descartada; limites ficam em memória.
# LEITOR_IA_DESLIGADO=1                      # desliga as rotas (503; o programa segue digitando)
# LEITOR_IA_MODELO_RAPIDO=claude-sonnet-5
# LEITOR_IA_MODELO_FORTE=claude-opus-5-5
# LEITOR_IA_TETO_REAIS_DIA=30                # teto de gasto estimado por dia (R$)
# LEITOR_IA_LIMITE_LICENCA_DIA=80
# LEITOR_IA_LIMITE_AVALIACAO_DIA=6
# LEITOR_IA_LIMITE_AVALIACAO_TOTAL_DIA=150
# LEITOR_IA_LIMITE_IP_HORA=60
# LEITOR_IA_PEDIDOS_IP_MINUTO=30
# LEITOR_IA_LIMITE_TOTAL_DIA=1500
# LEITOR_IA_SIMULTANEAS=6
# LEITOR_IA_SIMULTANEAS_AVALIACAO=2
# LEITOR_IA_LICENCAS_BLOQUEADAS=             # ids de licença separados por vírgula
# LEITOR_IA_IP_HEADER=                       # ex.: cf-connecting-ip (só se o DNS passar pelo Cloudflare)
