# Servidor
PORT=3000
NODE_ENV=production

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE=ecosunpower
WEBHOOK_TOKEN=um-token-secreto-para-validar-webhooks

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-sua-chave

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-key

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Engenheiro (numero que recebe dossies)
ENGINEER_PHONE=5561999999999
ENGINEER_NAME=Seu Nome

# Tavus (clone de video do Junior pra anuncios Meta)
TAVUS_API_KEY=sua-tavus-api-key
TAVUS_REPLICA_ID=r6e1a145xxxxxxxx
TAVUS_API_URL=https://tavusapi.com

# Meta Conversions API — dataset/antigo pixel. SEM default no codigo (identidade
# da empresa). Sem a env o CAPI fica off com aviso no boot.
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# META_CAPI_DATASET_ID=1053629086258723
META_CAPI_DATASET_ID=

# Repo GitHub do site (blog auto-publisher + /novo-case). SEM default no codigo
# (identidade da empresa). Sem a env a publicacao no site fica off com aviso.
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# GITHUB_SITE_REPO=junior-candido/ecosunpower-site
GITHUB_SITE_REPO=

# Para onde vai a RESPOSTA do cliente aos e-mails da jornada.
# Obrigatorio na pratica: o EMAIL_FROM fica num subdominio de ENVIO da Resend
# (ex. news.empresa.com.br), que assina e entrega mas NAO tem MX — nao recebe.
# Como os 6 modelos terminam com "e so responder este e-mail", sem esta variavel
# toda resposta de cliente volta como bounce e ninguem fica sabendo.
# Se faltar, o app grita no boot: "[email-seq] ATENCAO: EMAIL_REPLY_TO nao configurado".
# Valor da EcoSunPower (conferir no Easypanel ANTES de implantar):
# EMAIL_REPLY_TO=junior@ecosunpower.eng.br
EMAIL_REPLY_TO=
